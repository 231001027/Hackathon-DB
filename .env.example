# Smart Ability Hackathon Portal - Environment Configuration
# Copy this file to .env and configure for your environment

# ============================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================================
# Get these from your Supabase project dashboard: https://supabase.com
# Project Settings > API > URL and Keys

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-key-here

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# App Environment: development | staging | production
VITE_MODE=development

# API Configuration
VITE_API_URL=http://localhost:5174
VITE_API_TIMEOUT=30000

# Auth Configuration
VITE_AUTH_TIMEOUT=3600000
VITE_AUTH_REDIRECT=/student-login

# ============================================================
# FEATURE FLAGS
# ============================================================

VITE_ENABLE_EMAIL_VERIFICATION=false
VITE_ENABLE_PASSWORD_RESET=false
VITE_ENABLE_SOCIAL_AUTH=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_TEAM_SELECTION=true
VITE_ENABLE_PROJECT_ABSTRACTS=true
VITE_ENABLE_ADMIN_PANEL=true

# ============================================================
# SECURITY
# ============================================================

VITE_ENABLE_RATE_LIMIT=true
VITE_ENABLE_CSP=true
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_SECURE_COOKIES=true
VITE_HSTS_MAX_AGE=31536000

# ============================================================
# LOGGING & DEBUGGING
# ============================================================

VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=debug
# Options: error | warn | info | debug

# ============================================================
# CACHE CONFIGURATION
# ============================================================

VITE_CACHE_TTL=300000
VITE_CACHE_STORAGE=localStorage

# ============================================================
# THIRD-PARTY SERVICES (Future Use)
# ============================================================

# Email Service (SendGrid, AWS SES, etc.)
# VITE_EMAIL_SERVICE_KEY=your_key_here

# Analytics (Google Analytics, Mixpanel, etc.)
# VITE_ANALYTICS_KEY=your_key_here

# File Storage (AWS S3, Google Cloud Storage, Supabase Storage, etc.)
# VITE_STORAGE_BUCKET=your_bucket_name

# ============================================================
# LIMITS
# ============================================================

VITE_MAX_FILE_SIZE_MB=10
VITE_MAX_TEAM_MEMBERS=5
VITE_REGISTRATION_LIMIT_PER_HOUR=50

# ============================================================
# THEME & UI
# ============================================================

VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_ANIMATIONS=true
VITE_TOAST_DURATION_MS=4000

# ============================================================
# ENVIRONMENT
# ============================================================

NODE_ENV=development
